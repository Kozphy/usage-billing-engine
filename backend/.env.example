APP_NAME=Usage Billing Engine
ENVIRONMENT=local
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./billing.db
# Compose Postgres example:
# DATABASE_URL=postgresql+psycopg://billing:billing@127.0.0.1:5433/billing
REDIS_URL=redis://localhost:6379/0
OUTBOX_SYNC=true
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BACKOFF_SECONDS=2
WORKER_ID=api
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_test_secret
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_TIMEOUT_RATE=0
CORS_ORIGINS=http://localhost:5173
FEATURE_SHADOW_PRICING=false
LOG_LEVEL=INFO
SHADOW_EXPECTED_TOLERANCE=0.0000
